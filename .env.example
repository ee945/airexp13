# 复制为 .env 后执行：php artisan key:generate
APP_NAME="出口单证系统"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8088
# 旧站（Laravel 5.4 版本）地址，仅供未迁移模块的占位页显示对照链接；不填则不显示链接
LEGACY_APP_URL=http://127.0.0.1:8081

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

# 旧库密码哈希的 cost 就是 10，改动会在登录时触发 needsRehash 静默改写生产库
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# 必须指向原有业务库（与本系统共库的旧站是同一套表），库名/账号按部署环境填写
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=

# 与原站共库：session / cache / queue 一律不要用 database 驱动，避免污染业务表
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=airexp13_session
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 发信时按服务商填 SMTP 主机/账号；仅调试可把 MAIL_MAILER 改成 log
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=25
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
# 发信人名称，Laravel 读取的键名是 MAIL_FROM_NAME（config/mail.php）
MAIL_FROM_NAME="${APP_NAME}"

## ---- 业务配置（沿用原站 .env） ----
# 主题/模板目录：resources/views 下的子目录名
APP_TM=default

# 网站名称：brand 标题 / 网页默认 title
CONF_SITE_NAME='出口单证系统'
# 公司代码：代理企业注册代码，用于制单等
CONF_AGENT_CODE='CODE'
# 公司名称地址：用于总单发货人（写成一行，用双引号，换行用 \n）
CONF_AGENT_ADDR="COMPANY NAME\nADDRESS\nTEL"
# 分单前缀：分运单及清单上显示的 HAWB 前缀
CONF_HAWB_PREFIX=AWB

# 若 storage/framework/views 内禁止 rename()/unlink()（Blade 原子写入会 EPERM），
# 去掉下面这行的注释并指到可写临时目录：
# VIEW_COMPILED_PATH=/var/tmp/airexp13/views

## ---- 备用（Laravel 默认自带，本机未使用）----
